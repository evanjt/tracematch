#!/usr/bin/env bash
# core.hooksPath replaces .git/hooks entirely, so every gate runs from here.
#
# Only the fast gates run here. scripts/ci-local.sh runs clippy, the other
# static lanes and the tests the way CI does.
set -e

ROOT="$(git rev-parse --show-toplevel)"

"$ROOT/scripts/check-no-private-data.sh"
cargo fmt --check
